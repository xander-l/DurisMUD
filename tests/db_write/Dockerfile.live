# ==============================================================================
# tests/db_write/Dockerfile.live
#
# Live DB integration test Dockerfile — spins up MySQL 8.0, creates the
# test schema, compiles the live test binary WITH real MySQL support,
# and runs all three suites:
#   1. Frag & Item Transfer   (frag_leaderboard, account_characters)
#   2. Locker Stress          (lockers, locker_chests, locker_items)
#   3. Latency Guard          (latency_trace, timing measurements)
#
# Unlike Dockerfile.test (which runs source-grep tests without MySQL),
# this image compiles against libmysqlclient and tests real DB roundtrips.
#
# Usage:
#   docker build -f tests/db_write/Dockerfile.live -t duris-db-live-test .
#   docker run --rm duris-db-live-test
#   docker run --rm duris-db-live-test ./test_live_db frags
# ==============================================================================

FROM mysql:8.0 AS mysql

FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# ---- System packages: gcc, make, MySQL client lib + headers ---------------
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        make \
        dos2unix \
        libmysqlclient-dev \
        mysql-client \
        mysql-server \
    && rm -rf /var/lib/apt/lists/*

# ---- Start MySQL, create database and schema ------------------------------
# We use MySQL in the same container for simplicity (test-only, not prod).
RUN mkdir -p /var/run/mysqld && \
    chown mysql:mysql /var/run/mysqld && \
    mysqld --user=mysql --datadir=/var/lib/mysql --skip-grant-tables &
# We'll use a startup script instead — see below.

# ---- Copy live test sources + schema --------------------------------------
WORKDIR /duris
COPY tests/db_write/schema.sql /duris/tests/db_write/schema.sql
COPY tests/db_write/test_live_main.c /duris/tests/db_write/test_live_main.c
COPY tests/db_write/test_live_frags.c /duris/tests/db_write/test_live_frags.c
COPY tests/db_write/test_live_locker.c /duris/tests/db_write/test_live_locker.c
COPY tests/db_write/test_live_latency.c /duris/tests/db_write/test_live_latency.c
COPY tests/db_write/test_live_accounts.c /duris/tests/db_write/test_live_accounts.c
COPY tests/db_write/Makefile.live /duris/tests/db_write/Makefile.live

# ---- Startup script: start MySQL, init schema, build and run --------------
RUN echo '#!/bin/bash\n\
set -e\n\
\n\
# Start MySQL in background\n\
echo "Starting MySQL..."\n\
mkdir -p /var/run/mysqld /var/lib/mysql\n\
chown -R mysql:mysql /var/run/mysqld /var/lib/mysql\n\
\n\
# Initialize MySQL data directory if needed\n\
if [ ! -f /var/lib/mysql/ibdata1 ]; then\n\
    mysqld --initialize-insecure --user=mysql --datadir=/var/lib/mysql 2>&1 | tail -3\n\
fi\n\
\n\
mysqld --user=mysql --datadir=/var/lib/mysql &\n\
MYSQL_PID=$!\n\
\n\
# Wait for MySQL to be ready (max 30s)\n\
echo "Waiting for MySQL to start..."\n\
for i in $(seq 1 30); do\n\
    if mysqladmin ping -u root --silent 2>/dev/null; then\n\
        break\n\
    fi\n\
    sleep 1\n\
done\n\
\n\
if ! mysqladmin ping -u root --silent 2>/dev/null; then\n\
    echo "ERROR: MySQL failed to start"\n\
    exit 1\n\
fi\n\
\n\
echo "MySQL is ready."\n\
\n\
# Create test database and user\n\
mysql -u root -e "CREATE DATABASE IF NOT EXISTS duris_test CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;"\n\
mysql -u root -e "CREATE USER IF NOT EXISTS '\''duris'\''@'\''127.0.0.1'\'' IDENTIFIED BY '\''duris'\'';"\n\
mysql -u root -e "GRANT ALL PRIVILEGES ON duris_test.* TO '\''duris'\''@'\''127.0.0.1'\'';"\n\
mysql -u root -e "FLUSH PRIVILEGES;"\n\
\n\
# Load schema\n\
echo "Loading schema..."\n\
mysql -u root duris_test < /duris/tests/db_write/schema.sql 2>&1 | tail -3\n\
\n\
# Build the live test binary\n\
cd /duris/tests/db_write\n\
dos2unix *.c 2>/dev/null || true\n\
make -f Makefile.live clean\n\
echo "Building live test binary..."\n\
make -f Makefile.live 2>&1\n\
\n\
# Run the tests\n\
echo ""\n\
echo "Running live DB integration tests..."\n\
DB_HOST=127.0.0.1 DB_USER=duris DB_PASSWD=duris DB_NAME=duris_test DB_PORT=3306 ./test_live_db\n\
EXIT_CODE=$?\n\
\n\
# Shutdown MySQL\n\
kill $MYSQL_PID 2>/dev/null || true\n\
wait $MYSQL_PID 2>/dev/null || true\n\
\n\
exit $EXIT_CODE\n\
' > /duris/startup.sh && chmod +x /duris/startup.sh

CMD ["/duris/startup.sh"]
